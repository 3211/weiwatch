# Copy this file to .env and edit the values.

# Port exposed on the host (the container always listens on 3000).
PORT=3000

# REQUIRED. Long random string used to sign session cookies.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-me-with-a-long-random-string

# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false

# Set to true when running behind a reverse proxy (nginx, Caddy, Traefik...).
TRUST_PROXY=false

# Optional tuning
# HOST_GRACE_SECONDS=90
# ROOM_IDLE_MINUTES=180
# PROXY_TIMEOUT_MS=20000
# PROXY_MAX_HTML_BYTES=8388608
